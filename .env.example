# Session signing secret (required in production: `openssl rand -hex 32`)
AUTH_SECRET=

# Local dev uses a SQLite file in data/ by default. Set these to use Turso in production.
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=

# Vercel Blob (required in production for file uploads; local dev falls back to ./uploads)
# BLOB_READ_WRITE_TOKEN=

# Seed admin credentials used by `npm run seed`
NM_ADMIN_EMAIL=
NM_ADMIN_PASSWORD=
